SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Weekly Docker cleanup (Sun, UTC)
0 4 * * 0 root docker builder prune -f --filter until=168h >> /var/log/docker-cleanup.log 2>&1
10 4 * * 0 root docker image prune -a -f --filter until=168h >> /var/log/docker-cleanup.log 2>&1
